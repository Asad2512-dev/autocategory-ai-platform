# Environment files (never commit secrets)
.env
.env.*
!.env.example
!.env.production.example
!ml-service/.env.example

# OS / editor artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs / runtime output
*.log
storage/logs/*
ml-service/logs/

# PHP / Laravel
/vendor/
/node_modules/
/public/storage
/storage/*.key
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/bootstrap/cache/*.php
/.phpunit.result.cache

# Python caches / environments
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
ml-service/.venv/
ml-service/__pycache__/
ml-service/.pytest_cache/
ml-service/.mypy_cache/
ml-service/.ruff_cache/

# Build output
/dist/
/build/
ml-service/deploy_bundle/.build/

# Archives
*.zip
*.tar
*.gz
*.tgz
