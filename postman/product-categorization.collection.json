    {
      "name": "AI Prediction",
      "description": "Laravel calls FastAPI on the server. Product / prediction payloads may include `prediction_source` from ML: **model**, **keyword_fallback**, or **gemini_fallback** (see stored `prediction_logs`).",
      "item": [
        {
          "name": "Predict Category for Product",
          "request": {
            "method": "POST",
