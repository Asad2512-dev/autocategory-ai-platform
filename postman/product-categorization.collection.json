    {
      "name": "ML Debug (internal only)",
      "description": "Calls **FastAPI** at `{{ml_base_url}}`. `127.0.0.1:8001` is only reachable **on the VPS** or via SSH tunnel:\n\n`ssh -L 8001:127.0.0.1:8001 user@autocategoryai.online`\n\n**Security:** keep FastAPI on localhost in production; do not expose `/debug/*` publicly.\n\n**Predict** uses ML first; may escalate to keywords or Gemini (`prediction_source` in JSON).",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{ml_base_url}}/health",
            "description": "FastAPI readiness. JSON includes `status`, `model_dir`, thresholds, `gemini_enabled`, `gemini_force_verify`, `artifact_status`."
          }
        },
        {
          "name": "Predict (direct to ML)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Wireless earbuds\",\n  \"description\": \"Bluetooth in-ear headphones with charging case\",\n  \"brand\": \"ExampleBrand\"\n}"
            },
            "url": "{{ml_base_url}}/predict",
            "description": "Full ML pipeline (internal / tunnel). Response includes `prediction_source`: **model** | **keyword_fallback** | **gemini_fallback**, plus `message`, `top_candidates`, `suggested_new_category` (when very low confidence), etc."
          }
        },
        {
          "name": "Predict — edge case (variables)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{ml_predict_title}}\",\n  \"description\": \"{{ml_predict_description}}\",\n  \"brand\": \"{{ml_predict_brand}}\"\n}"
            },
            "url": "{{ml_base_url}}/predict",
            "description": "Same as **Predict (direct)** but uses env vars — e.g. bra/charger/shelf text to exercise Gemini escalation when `GEMINI_ENABLED=true`."
          }
        },
        {
          "name": "Gemini Fallback Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{gemini_test_title}}\",\n  \"description\": \"{{gemini_test_description}}\",\n  \"brand\": \"{{gemini_test_brand}}\"\n}"
            },
            "url": "{{ml_base_url}}/debug/gemini-fallback-check",
            "description": "Debug endpoint for Gemini fallback path.\n\nStatus codes: 200"
          },
          "response": [
            {
              "name": "200 Success",
              "originalRequest": { "method": "POST", "url": "{{ml_base_url}}/debug/gemini-fallback-check" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"gemini_enabled\": true,\n  \"fallback_tested\": true,\n  \"prediction_source\": \"gemini_fallback\",\n  \"predicted_category\": \"Fashion\",\n  \"suggested_new_category\": \"Women Innerwear > Bra\",\n  \"confidence\": 0.95,\n  \"review_needed\": false,\n  \"reason\": \"Example\",\n  \"raw_response_available\": true,\n  \"message\": \"Gemini fallback check completed successfully.\",\n  \"error\": null\n}"
            }
          ]
        }
      ]
    }
  ]
}
