# FastAPI / ML service production environment (AutoCategory AI)
# On the VPS, copy to: /opt/autocategory-fastapi/.env
# Source code in this repo lives under: ml-service/ (nested inside the Laravel monorepo locally; deployed alone to /opt).

# Absolute path to model.pkl, vectorizer.pkl, label_encoder.pkl
MODEL_DIR=/opt/autocategory-fastapi/model

MODEL_CONFIDENCE_THRESHOLD=0.75
VERY_LOW_CONFIDENCE_THRESHOLD=0.45

# Writable by the service user (www-data) — used by POST /feedback
FEEDBACK_DATASET_PATH=/opt/autocategory-fastapi/data/feedback_corrections.csv

# Gemini fallback (optional). Never commit a real key.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_FORCE_VERIFY=false
