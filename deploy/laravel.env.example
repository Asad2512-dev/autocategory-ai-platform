# Laravel production environment (AutoCategory AI)
# Copy to the server as .env in the Laravel root (same directory as artisan).
# Local repo layout: Laravel root = product-categorization-backend/ (ml-service/ is a sibling folder, not deployed inside Laravel).

APP_NAME="AutoCategory AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://autocategoryai.online

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autocategoryai
DB_USERNAME=autocategoryaiUser
DB_PASSWORD=5Ez8OdSiUn3OsT01SQJx

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.autocategoryai.online

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Hostinger KVM1: no Redis — database queue + database cache (migrations create jobs + cache tables).
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=autocategory_

# FastAPI listens on localhost only (systemd). Laravel uses config/services.php — ML_SERVICE_BASE_URL wins if set.
ML_SERVICE_BASE_URL=http://127.0.0.1:8001
# AI_SERVICE_URL=http://127.0.0.1:8001

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@autocategoryai.online"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=autocategoryai.online,www.autocategoryai.online
