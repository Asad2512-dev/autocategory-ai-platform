# Directory containing model.pkl, vectorizer.pkl, label_encoder.pkl (default: ./model relative to app)
# MODEL_DIR=/opt/autocategory-fastapi/model

# Main threshold to trust model result directly.
MODEL_CONFIDENCE_THRESHOLD=0.75

# Very low confidence threshold where Gemini may suggest a more specific display label.
VERY_LOW_CONFIDENCE_THRESHOLD=0.45

# Backward compatibility (used only if MODEL_CONFIDENCE_THRESHOLD is not set).
# CONFIDENCE_THRESHOLD=0.75

# Feedback corrections CSV (must be writable by the service user).
# FEEDBACK_DATASET_PATH=/opt/autocategory-fastapi/data/feedback_corrections.csv

# Gemini fallback (optional). Use a real key from Google AI Studio; never commit it.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=8

# If true, every /predict call asks Gemini for the final category (can override ML). For local experiments only.
GEMINI_FORCE_VERIFY=false
